<Window x:Class="PCL.HybridLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCL"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PCL-MOON · 游戏启动" Width="760" Height="416" MinWidth="540" MinHeight="376"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="True" Topmost="False" Background="#0D0F12" Foreground="#ECEDEF"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="WindowStateChanged" Closed="WindowClosed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" NonClientFrameEdges="None" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="HybridTheme.xaml" /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Shell" BorderThickness="1" MouseLeftButtonDown="ShellMouseLeftButtonDown">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#473B28" Offset="0" />
                <GradientStop Color="#282B31" Offset="0.35" />
                <GradientStop Color="#1F2227" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F1115" Offset="0" />
                <GradientStop Color="#0D0F12" Offset="0.58" />
                <GradientStop Color="#12110F" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <local:HybridLaunchScreen x:Name="Screen" />
    </Border>
</Window>
