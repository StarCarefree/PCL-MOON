<UserControl x:Class="PCL.HybridBrowseLoading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True" IsHitTestVisible="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="#1C1C1C" />
                <Setter Property="BorderBrush" Value="#2E2E2E" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="Bar" TargetType="Border">
                <Setter Property="Background" Value="#262626" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- WebView2 首次初始化期间的占位骨架，布局对应 www/index.html；WebView 就绪后淡出 -->
    <Grid Background="#141414" ClipToBounds="True">
        <Rectangle Height="2" VerticalAlignment="Top">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform x:Name="ProgressShift" X="-1" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#00E0A24A" Offset="0.15" />
                    <GradientStop Color="#FFE0A24A" Offset="0.5" />
                    <GradientStop Color="#00E0A24A" Offset="0.85" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid x:Name="Skeleton" MaxWidth="1600" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="RowHeader" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PCL-MOON · DISCOVER" Foreground="#E0A24A" FontSize="11" Margin="0,0,0,6" />
                    <Border Style="{StaticResource Bar}" Width="112" Height="22" CornerRadius="4" />
                    <Border Style="{StaticResource Bar}" Width="132" Height="10" Margin="0,10,0,0" CornerRadius="4" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Panel}" Width="520" Height="68" Margin="24,0,16,0"
                        HorizontalAlignment="Right" CornerRadius="8" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Bar}" Width="96" Height="36" Margin="0,0,8,0" />
                    <Border Style="{StaticResource Bar}" Width="96" Height="36" />
                </StackPanel>
            </Grid>
            <Border x:Name="RowDiscover" Grid.Row="1" Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource Bar}" Width="140" Height="10" CornerRadius="4" />
                            <Border Style="{StaticResource Bar}" Width="180" Height="24" Margin="0,8,0,0" CornerRadius="4" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Bar}" Height="44" HorizontalAlignment="Stretch" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Border Style="{StaticResource Bar}" Width="72" Height="36" Margin="0,0,8,0" Background="#2E271D" />
                        <Border Style="{StaticResource Bar}" Width="64" Height="36" Margin="0,0,8,0" />
                        <Border Style="{StaticResource Bar}" Width="56" Height="36" Margin="0,0,8,0" />
                        <Border Style="{StaticResource Bar}" Width="64" Height="36" Margin="0,0,8,0" />
                        <Border Style="{StaticResource Bar}" Width="64" Height="36" Margin="0,0,8,0" />
                        <Border Style="{StaticResource Bar}" Width="96" Height="36" />
                    </StackPanel>
                    <Rectangle Height="1" Fill="#2E2E2E" Margin="0,16" />
                    <UniformGrid Rows="1" Columns="5">
                        <Border Style="{StaticResource Bar}" Height="36" HorizontalAlignment="Stretch" Margin="0,0,12,0" />
                        <Border Style="{StaticResource Bar}" Height="36" HorizontalAlignment="Stretch" Margin="0,0,12,0" />
                        <Border Style="{StaticResource Bar}" Height="36" HorizontalAlignment="Stretch" Margin="0,0,12,0" />
                        <Border Style="{StaticResource Bar}" Height="36" HorizontalAlignment="Stretch" Margin="0,0,12,0" />
                        <Border Style="{StaticResource Bar}" Height="36" HorizontalAlignment="Stretch" />
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border x:Name="RowTitle" Grid.Row="2" Style="{StaticResource Bar}" Width="180" Height="14" Margin="0,0,0,16" CornerRadius="4" />
            <Grid x:Name="RowStage" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" Height="320" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 与网页赞助位一致的月牙标记 -->
                        <Viewbox x:Name="Mark" Width="34" Height="34" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <ScaleTransform x:Name="MarkScale" />
                            </Viewbox.RenderTransform>
                            <Path Fill="#E0A24A">
                                <Path.Data>
                                    <GeometryGroup>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1><EllipseGeometry Center="18,21" RadiusX="14" RadiusY="14" /></CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2><EllipseGeometry Center="25,15" RadiusX="11" RadiusY="11" /></CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                        <PathGeometry Figures="M30,6.5 L31.1,9.9 L34.5,11 L31.1,12.1 L30,15.5 L28.9,12.1 L25.5,11 L28.9,9.9 Z" />
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Viewbox>
                        <TextBlock Text="正在载入资源目录" Foreground="#F3F1EC" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,4" />
                        <TextBlock Text="首次打开需要初始化浏览组件" Foreground="#A39E96" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="RowRecommend" Grid.Column="2" Style="{StaticResource Panel}" Padding="12" Height="320" VerticalAlignment="Top">
                    <StackPanel x:Name="Recommend">
                        <Border Style="{StaticResource Bar}" Width="72" Height="14" CornerRadius="4" />
                        <Border Style="{StaticResource Bar}" Width="160" Height="10" Margin="0,8,0,14" CornerRadius="4" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
